# ----------------------------------------------------------------------------
# Node / server
# ----------------------------------------------------------------------------
# Business time zone. Must stay the IANA name (never a fixed offset).
TZ=Africa/Casablanca
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------
# Generate with: node ace generate:key
APP_KEY=
# Public base URL, used for links in emails
APP_URL=http://localhost:3333

# Reverse proxies allowed to set X-Forwarded-For (drives request.ip(), used by
# the login rate limiters). Empty = "loopback" (nginx / Apache-Passenger on the
# same host, e.g. cPanel). "false" = app exposed directly, trust no header.
# Otherwise a comma list of IPs/CIDRs or loopback|linklocal|uniquelocal,
# e.g. "loopback, 10.0.0.0/8". List every proxy/CDN in front of the app.
# "true" (trust anyone) or a list covering public addresses is refused at startup.
# nginx must append: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
TRUST_PROXY=

# Session store: cookie | database | memory (memory only for tests)
SESSION_DRIVER=cookie

# ----------------------------------------------------------------------------
# PostgreSQL (docker compose: port 5432, user/password bfk/bfk)
# ----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=bfk
DB_PASSWORD=bfk
DB_DATABASE=bfk_dev

# ----------------------------------------------------------------------------
# Rate limiter store: database (dev/prod) | memory (tests)
# ----------------------------------------------------------------------------
LIMITER_STORE=database

# ----------------------------------------------------------------------------
# Mail
# MAIL_MAILER=smtp -> sends through SMTP_HOST/SMTP_PORT (Mailpit in dev: 1025, UI on :8025)
# MAIL_MAILER=log  -> development/test only (refused at startup in production):
#                     logs subject + masked recipient, body omitted
# MAIL_LOG_BODY=true -> with the log mailer, also log the text body so you can
#                     read invitation / reset links in dev. Ignored in production.
# Tests always use the fake mailer (mail.fake()).
# ----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_LOG_BODY=false
MAIL_FROM_NAME=BFK School Meals
MAIL_FROM_ADDRESS=no-reply@bfk.local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# Outbox (menu published, reminders, cancellations…) drained by `node ace mail:dispatch`
# every minute: at most MAIL_MAX_PER_RUN emails per run and MAIL_MAX_PER_HOUR per rolling
# hour. Set MAIL_MAX_PER_HOUR to the SMTP host's hourly limit (cPanel hosts often cap it).
MAIL_MAX_PER_RUN=50
MAIL_MAX_PER_HOUR=250

# ----------------------------------------------------------------------------
# File storage (meal photos)
# DRIVE_DISK=fs -> local disk in ./storage (dev/test; never served directly:
#                  photos go through /media/meal-photos/:id/:variant, auth only)
# DRIVE_DISK=s3 -> S3-compatible bucket (production). Keep the bucket PRIVATE:
#                  the app redirects logged-in users to short-lived signed URLs.
#   AWS S3:        S3_REGION=eu-west-3, no S3_ENDPOINT
#   Cloudflare R2: S3_REGION=auto, S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   MinIO:         S3_ENDPOINT=http://127.0.0.1:9000, S3_FORCE_PATH_STYLE=true
#                  (production requires an https S3_ENDPOINT)
# The production CSP img-src automatically allows exactly the bucket origin the
# signed URLs use (app/support/storage_origin.ts): https://<bucket>.s3.<region>.amazonaws.com
# on AWS, https://<bucket>.<endpoint host> with an endpoint, or the endpoint
# origin with S3_FORCE_PATH_STYLE=true (or a bucket name with dots).
# S3_PUBLIC_ORIGIN: only if your provider signs URLs on another host; an https
# origin without path (e.g. https://files.example.com). Never a wildcard.
# ----------------------------------------------------------------------------
DRIVE_DISK=fs
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_ORIGIN=
