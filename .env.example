# ----------------------------------------------------------------------------
# Node / server
# ----------------------------------------------------------------------------
# Business time zone. Must stay the IANA name (never a fixed offset).
TZ=Africa/Casablanca
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------
# Generate with: node ace generate:key
APP_KEY=
# Public base URL, used for links in emails
APP_URL=http://localhost:3333

# Session store: cookie | database | memory (memory only for tests)
SESSION_DRIVER=cookie

# ----------------------------------------------------------------------------
# PostgreSQL (docker compose: port 5432, user/password bfk/bfk)
# ----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=bfk
DB_PASSWORD=bfk
DB_DATABASE=bfk_dev

# ----------------------------------------------------------------------------
# Rate limiter store: database (dev/prod) | memory (tests)
# ----------------------------------------------------------------------------
LIMITER_STORE=database

# ----------------------------------------------------------------------------
# Mail
# MAIL_MAILER=smtp -> sends through SMTP_HOST/SMTP_PORT (Mailpit in dev: 1025, UI on :8025)
# MAIL_MAILER=log  -> no SMTP server needed; mails are written to the app log
# Tests always use the fake mailer (mail.fake()).
# ----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_FROM_NAME=BFK School Meals
MAIL_FROM_ADDRESS=no-reply@bfk.local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
