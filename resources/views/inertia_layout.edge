<!DOCTYPE html>
<html lang="{{ i18n?.locale ?? 'fr' }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#571B1E" />
    <title data-inertia>
      British Academy × Beldi Fusion
    </title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icons/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Beldi Fusion Kitchen × British Academy" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <style>
      #app-splash { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; background: #fff; transition: opacity 0.3s; }
      #app-splash[hidden] { display: none; }
      #app-splash.app-splash-out { opacity: 0; }
      #app-splash img { width: min(70vw, 320px); height: auto; }
    </style>

    @vite(['inertia/app.ts'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    <div id="app-splash" hidden aria-hidden="true"></div>
    <script src="/splash.js"></script>
    @inertia()
  </body>

</html>
