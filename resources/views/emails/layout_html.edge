{{--
  Shared layout of every email (BFK School Meals × Britech School).
  Every value is escaped ({{ }}); never use {{{ }}} here.
--}}
<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{{ subject }}</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f6f5;font-family:Arial,Helvetica,sans-serif;color:#14211b;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#f4f6f5;">{{ preheader }}</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f5;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">
            <tr>
              <td style="padding:0 4px 16px;">
                <table role="presentation" cellpadding="0" cellspacing="0">
                  <tr>
                    <td><img src="{{ logoUrl }}" alt="BFK" width="74" height="48" style="display:block;border:0;" /></td>
                    <td style="padding-left:10px;">
                      <div style="font-size:15px;font-weight:800;color:#14211b;">{{ brand }}</div>
                      <div style="font-size:12px;color:#56655e;">{{ partner }}</div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="background:#ffffff;border:1px solid #e2e7e4;border-radius:16px;padding:28px 28px 8px;">
                <h1 style="font-size:22px;line-height:1.3;margin:0 0 14px;color:#14211b;">{{ title }}</h1>
                <p style="font-size:15px;line-height:1.55;margin:0 0 14px;">{{ greeting }}</p>
                @each(paragraph in paragraphs)
                  <p style="font-size:15px;line-height:1.55;margin:0 0 14px;color:#33433c;">{{ paragraph }}</p>
                @end
                @if(items.length)
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 16px;background:#f1f4f2;border-radius:12px;">
                    @each(item in items)
                      <tr>
                        <td style="padding:8px 14px;font-size:14px;line-height:1.45;color:#14211b;">&#8226;&nbsp;{{ item }}</td>
                      </tr>
                    @end
                  </table>
                @end
                @if(url)
                  <p style="margin:6px 0 18px;">
                    <a href="{{ url }}" style="display:inline-block;background:#1f6f4a;color:#ffffff;text-decoration:none;font-weight:700;font-size:15px;border-radius:12px;padding:14px 22px;">{{ action }}</a>
                  </p>
                @end
                @each(note in notes)
                  <p style="font-size:13px;line-height:1.5;margin:0 0 10px;color:#56655e;">{{ note }}</p>
                @end
                @if(url)
                  <p style="font-size:12px;line-height:1.5;margin:0 0 16px;color:#56655e;">{{ fallback }}<br /><span style="word-break:break-all;color:#175a3b;">{{ url }}</span></p>
                @end
                <p style="font-size:14px;line-height:1.5;margin:0 0 20px;">{{ signature }}</p>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 8px 0;font-size:12px;line-height:1.5;color:#56655e;text-align:center;">
                @if(footer)
                  <p style="margin:0 0 6px;">{{ footer }}</p>
                @end
                @if(preferencesUrl)
                  <p style="margin:0 0 6px;"><a href="{{ preferencesUrl }}" style="color:#175a3b;">{{ preferencesLabel }}</a></p>
                @end
                <p style="margin:0;">{{ automatic }} · <a href="{{ homeUrl }}" style="color:#175a3b;">{{ brand }}</a></p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
