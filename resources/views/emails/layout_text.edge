{{{ paragraph }}}

@end
@each(item in items)
- {{{ item }}}
@end
@if(items.length)

@end
@if(url)
{{{ action }}}: {{{ url }}}

@end
@each(note in notes)
{{{ note }}}

@end
{{{ signature }}}

--
@if(footer)
{{{ footer }}}
@end
@if(preferencesUrl)
{{{ preferencesLabel }}}: {{{ preferencesUrl }}}
@end
{{{ automatic }}}
